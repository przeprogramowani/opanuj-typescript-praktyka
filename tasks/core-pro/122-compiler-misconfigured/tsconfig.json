{
  "compilerOptions": {
    "target": "ES5",
    "moduleResolution": "node10",
    "allowImportingTsExtensions": true,
    "esModuleInterop": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "strict": true
  }
}
